# Copy this file to .env and fill in your key.
# Get a free Gemini API key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# --- Optional overrides (defaults shown) ---

# EMBEDDING_MODEL=gemini-embedding-001
# GENERATION_MODEL=gemini-2.5-flash

# MANUALS_DIR=data/manuals
# CHROMA_DIR=vectorstore
# COLLECTION_NAME=fridge_manuals

# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# TOP_K=5
# MAX_ANSWER_TOKENS=1024

# Comma-separated list of origins allowed to call the API in production,
# e.g. https://your-frontend.vercel.app. Defaults to "*" (fine for local dev,
# tighten this before you actually go live).
# ALLOWED_ORIGINS=*
